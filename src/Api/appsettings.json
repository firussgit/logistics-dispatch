{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Dispatch": "Data Source=dispatch.db"
  },
  "Routing": {
    "Provider": "Osrm",
    "BaseUrl": "http://localhost:5000",
    "TimeoutSeconds": 3,
    "FailureCooldownSeconds": 20
  },
  "Simulation": {
    "Enabled": true,
    "TickInterval": "00:00:01",
    "DriverSpeedMps": 15,
    "TimeScale": 4,
    "AutoAssign": true,
    "UseOffers": true,
    "OfferTimeout": "00:00:20",
    "DeclineCooldown": "00:00:30",
    "SimulatedResponseMin": "00:00:02",
    "SimulatedResponseMax": "00:00:06",
    "SimulatedAcceptRate": 0.75,
    "PickupDwell": "00:00:03"
  }
}
